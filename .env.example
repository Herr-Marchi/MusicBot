# Required. Get this from the Discord Developer Portal.
DISCORD_TOKEN=

# Optional. Set this during development to sync slash commands instantly to
# one guild instead of waiting for the global command sync (up to 1 hour).
DISCORD_GUILD_ID=

# Required. Matches the defaults in docker-compose.yml for local runs.
DATABASE_URL=postgresql+psycopg://musicbot:musicbot@localhost:5432/musicbot

# Required. Matches the default in docker-compose.yml for local runs.
REDIS_URL=redis://localhost:6379/0

# Optional. How long a guild's playback state survives in Redis with no
# activity, in seconds. Defaults to 86400 (24h) if unset.
REDIS_PLAYBACK_TTL_SECONDS=86400

# Optional. One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to DEBUG.
LOG_LEVEL=DEBUG
